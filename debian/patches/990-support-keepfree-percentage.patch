Index: deepin-systemd/src/libsystemd/sd-journal/journal-file.h
===================================================================
--- deepin-systemd.orig/src/libsystemd/sd-journal/journal-file.h
+++ deepin-systemd/src/libsystemd/sd-journal/journal-file.h
@@ -19,13 +19,20 @@
 #include "sparse-endian.h"
 #include "time-util.h"
 
+typedef struct JournalKeepFree {
+        /* If scale == 0, use value as absolute bytes (UINT64_MAX = auto).
+         * Otherwise keep_free = fs_size * value / scale, e.g. scale=10000 → permyriad. */
+        uint64_t value;
+        uint64_t scale;
+} JournalKeepFree;
+
 typedef struct JournalMetrics {
         /* For all these: UINT64_MAX means "pick automatically", and 0 means "no limit enforced" */
         uint64_t max_size;     /* how large journal files grow at max */
         uint64_t min_size;     /* how large journal files grow at least */
         uint64_t max_use;      /* how much disk space to use in total at max, keep_free permitting */
         uint64_t min_use;      /* how much disk space to use in total at least, even if keep_free says not to */
-        uint64_t keep_free;    /* how much to keep free on disk */
+        JournalKeepFree keep_free; /* how much to keep free on disk (absolute bytes or fraction of fs_size) */
         uint64_t n_max_files;  /* how many files to keep around at max */
 } JournalMetrics;
 
